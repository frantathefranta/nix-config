{
  "enabled": true,
  "sandboxUserShell": true,
  "permissionPromptTimeoutSeconds": 600,
  "network": {
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "flakehub.com",
      "cache.flakehub.com",
      "edge.cache.flakehub.com",
      "install.determinate.systems"
    ],
    "allowLocalBinding": true
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home"
    ],
    "allowRead": [
      ".",
      "~/.config",
      "~/.local",
      "Library",
      "/nix/store",
      "~/.nix-defexpr",
      "/nix/var/nix/daemon-socket/socket"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/bin/ps",
      "/nix/var/nix/daemon-socket/socket",
      "~/.cache"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
